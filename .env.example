# npm start / agent:* 通过 Node --env-file 读取这些值；浏览器仅能获知是否已配置 Key。
# 使用 DeepSeek 官方 API。复制为 .env 后，仅在本机填写密钥，不要发到聊天或提交到 Git。
# API 基础地址：程序会追加 /chat/completions。
LLM_BASE_URL=https://api.deepseek.com

# 支持工具调用；本例对 deepseek- 模型显式关闭思考模式，便于学习调用流程。
LLM_MODEL=deepseek-flash

# 在 DeepSeek 开放平台申请 API key，并仅在本机 .env 中替换占位符。
LLM_API_KEY=replace-with-your-deepseek-api-key
